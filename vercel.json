{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  "vite",
    "buildCommand":  "npm run build",
    "outputDirectory":  "dist",
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "https://worker-compilation-britney-reported.trycloudflare.com/api/:path*"
                     },
                     {
                         "source":  "/health",
                         "destination":  "https://worker-compilation-britney-reported.trycloudflare.com/health"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}