{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  "vite",
    "buildCommand":  "npm run build",
    "outputDirectory":  "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://YOUR-BACKEND-DOMAIN.railway.app/api/:path*"
        },
        {
            "source": "/health",
            "destination": "https://YOUR-BACKEND-DOMAIN.railway.app/health"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}