{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://tahoe-systematic-mention-awareness.trycloudflare.com/api/:path*"
        },
        {
            "source": "/health",
            "destination": "https://tahoe-systematic-mention-awareness.trycloudflare.com/health"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
